<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JobAutofill.App</RootNamespace>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.companyname.jobautofill</ApplicationId>
    <ApplicationTitle>Job Autofill</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" MonochromeFile="Resources/AppIcon/appiconmono.svg" ForegroundScale="0.65" Color="#2563EB" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#F7FAF8" BaseSize="256,256" />
    <MauiFont Include="Resources/Fonts/OpenSans-Regular.ttf" Alias="OpenSansRegular" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.14.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!-- Shared utilities (refactored from generic-engine) -->
    <AndroidAsset Include="Platforms/Android/Scripts/shared/text-utils.js" Link="shared/text-utils.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/shared/shared-runtime.js" Link="shared/shared-runtime.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/shared/dom-traversal.js" Link="shared/dom-traversal.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/shared/selector-resolver.js" Link="shared/selector-resolver.js" />
    <!-- WebView bridge helpers -->
    <AndroidAsset Include="Platforms/Android/Scripts/webview/bridge-runtime.js" Link="webview/bridge-runtime.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/site-rules/*.js" Link="site-rules/%(Filename)%(Extension)" />
    <!-- Metadata: built-in generic rules + resolver (site-specific metadata is provided by C# at runtime, not bundled) -->
    <AndroidAsset Include="Platforms/Android/Scripts/metadata/generic-field-control-rules.json" Link="metadata/generic-field-control-rules.json" />
    <AndroidAsset Include="Platforms/Android/Scripts/metadata/metadata-resolver.js" Link="metadata/metadata-resolver.js" />
    <!-- Generic engine modules -->
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/label-discovery.js" Link="generic-engine/label-discovery.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/control-classification.js" Link="generic-engine/control-classification.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/choice-selection.js" Link="generic-engine/choice-selection.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/choice-group-discovery.js" Link="generic-engine/choice-group-discovery.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/sensitive-fields.js" Link="generic-engine/sensitive-fields.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/capability-probe.js" Link="generic-engine/capability-probe.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/option-handling.js" Link="generic-engine/option-handling.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/option-source-handlers.js" Link="generic-engine/option-source-handlers.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/action-classification.js" Link="generic-engine/action-classification.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/page-classification.js" Link="generic-engine/page-classification.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/generic-engine/diagnostics.js" Link="generic-engine/diagnostics.js" />
    <!-- Scanner -->
    <AndroidAsset Include="Platforms/Android/Scripts/scanner/scanner-engine.js" Link="scanner/scanner-engine.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/scanner/scanner.js" Link="scanner/scanner.js" />
    <!-- Filler -->
    <AndroidAsset Include="Platforms/Android/Scripts/filler/fill.js" Link="filler/fill.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../JobAutofill.Core/JobAutofill.Core.csproj" />
    <ProjectReference Include="../JobAutofill.Domain/JobAutofill.Domain.csproj" />
    <ProjectReference Include="../JobAutofill.Infrastructure/JobAutofill.Infrastructure.csproj" />
    <ProjectReference Include="../JobAutofill.Telemetry/JobAutofill.Telemetry.csproj" />
  </ItemGroup>
</Project>
