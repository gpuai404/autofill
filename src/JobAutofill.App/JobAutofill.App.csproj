<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JobAutofill.App</RootNamespace>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.companyname.jobautofill</ApplicationId>
    <ApplicationTitle>Job Autofill</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.14.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidAsset Include="Platforms/Android/Scripts/runtime/dom-shared.js" Link="dom-shared.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/runtime/capability-probe.js" Link="capability-probe.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/scanner/detector.js" Link="detector.js" />
    <AndroidAsset Include="Platforms/Android/Scripts/scanner/field-control-rules.json" Link="field-control-rules.json" />
    <AndroidAsset Include="Platforms/Android/Scripts/filler/fill.js" Link="fill.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../JobAutofill.Core/JobAutofill.Core.csproj" />
    <ProjectReference Include="../JobAutofill.Domain/JobAutofill.Domain.csproj" />
    <ProjectReference Include="../JobAutofill.Infrastructure/JobAutofill.Infrastructure.csproj" />
    <ProjectReference Include="../JobAutofill.Telemetry/JobAutofill.Telemetry.csproj" />
  </ItemGroup>
</Project>
