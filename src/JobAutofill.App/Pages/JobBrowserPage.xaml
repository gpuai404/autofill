<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:JobAutofill.App"
             x:Class="JobAutofill.App.Pages.JobBrowserPage"
             Title="{x:Static app:AppLocalizer.AutofillPageTitle}"
             Shell.NavBarIsVisible="True">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ScanToolbarItem"
                     Text="{x:Static app:AppLocalizer.ScanAction}"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnScanClicked"
                     IsEnabled="True" />
        <ToolbarItem x:Name="FillToolbarItem"
                     Text="{x:Static app:AppLocalizer.FillAction}"
                     Order="Primary"
                     Priority="1"
                     Clicked="OnFillClicked"
                     IsEnabled="{Binding CanFill}" />
        <ToolbarItem x:Name="DebugToolbarItem"
                     Text="{x:Static app:AppLocalizer.DebugAction}"
                     Order="Secondary"
                     Priority="2"
                     Clicked="OnDebugClicked"
                     IsEnabled="False" />
    </ContentPage.ToolbarItems>

    <Grid Background="#F6F8FA">
        <WebView x:Name="JobWebView"
                 Navigated="OnWebViewNavigated"
                 Navigating="OnWebViewNavigating" />

        <Border x:Name="BottomSheet"
                Margin="0"
                Padding="14,8,14,14"
                HeightRequest="104"
                VerticalOptions="End"
                Stroke="#D8DEE4"
                StrokeThickness="1"
                Background="#FFFFFF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnBottomSheetPanUpdated" />
                <TapGestureRecognizer Tapped="OnBottomSheetTapped" />
            </Border.GestureRecognizers>

            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="10">
                <BoxView HeightRequest="4"
                         WidthRequest="44"
                         CornerRadius="2"
                         Color="#D0D7DE"
                         HorizontalOptions="Center" />

                <Grid x:Name="DetectedFieldsPanel"
                      Grid.Row="1"
                      RowDefinitions="Auto,*"
                      RowSpacing="6">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Application assistant"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#24292F" />
                        <Label Text="{Binding FieldSummary}"
                               FontSize="11"
                               TextColor="#57606A" />
                    </VerticalStackLayout>
                    <CollectionView x:Name="DetectedFieldsView"
                                    Grid.Row="1"
                                    ItemsSource="{Binding FieldGroups}"
                                    IsGrouped="True">
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Title}"
                                       Padding="0,10,0,4"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="#24292F" />
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="{x:Static app:AppLocalizer.ScanHint}"
                                   TextColor="#666666"
                                   FontSize="12" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="8">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="0">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDetectedFieldTapped"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Label}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding FillPreview}"
                                                   FontSize="12"
                                                   TextColor="#0969DA"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding DisplayTypeText}"
                                                   FontSize="12"
                                                   HorizontalTextAlignment="End"
                                                   TextColor="#57606A" />
                                            <Button Text="{Binding ApprovalActionText}"
                                                    Clicked="OnApproveFieldClicked"
                                                    IsVisible="{Binding CanApprove}"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    CornerRadius="6"
                                                    BorderWidth="1"
                                                    BorderColor="#0969DA"
                                                    Background="#FFFFFF"
                                                    TextColor="#0969DA"
                                                    CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Options Summary Label -->
                                    <Label Grid.Row="1"
                                           Text="{Binding OptionsSummary}"
                                           FontSize="11"
                                           TextColor="#57606A"
                                           IsVisible="{Binding ShouldShowOptionsSummary}"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Individual Option Buttons (Horizontal Scroll) -->
                                    <CollectionView Grid.Row="2"
                                                    ItemsSource="{Binding Options}"
                                                    SelectionMode="None"
                                                    IsVisible="{Binding HasOptions}"
                                                    HeightRequest="40">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Horizontal"
                                                               ItemSpacing="6" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Button Text="{Binding DisplayText}"
                                                        Clicked="OnDetectedFieldOptionClicked"
                                                        Padding="12,6"
                                                        FontSize="11"
                                                        CornerRadius="4"
                                                        BorderWidth="1"
                                                        BorderColor="#DDDDDD"
                                                        Background="#F6F8FA"
                                                        TextColor="#24292F"
                                                        CommandParameter="{Binding .}" />
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Grid Grid.Row="2"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="2"
                      Padding="0,4,0,0">
                    <Label x:Name="StatusLabel"
                           FontSize="12"
                           TextColor="#57606A"
                           LineBreakMode="TailTruncation"
                           Text="{Binding StatusText}" />
                    <Label x:Name="JobTitleLabel"
                           Grid.Row="1"
                           FontAttributes="Bold"
                           FontSize="14"
                           LineBreakMode="TailTruncation"
                           Text="{Binding JobTitle}" />
                    <Label x:Name="JobUrlLabel"
                           Grid.Row="2"
                           FontSize="12"
                           TextColor="#666666"
                           LineBreakMode="TailTruncation"
                           Text="{Binding JobUrl}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
