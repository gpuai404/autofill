<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:JobAutofill.App"
             xmlns:vm="clr-namespace:JobAutofill.App.ViewModels"
             x:Class="JobAutofill.App.Pages.ProfileEditorPage"
             x:DataType="vm:ProfileEditorViewModel"
             Title="{x:Static app:AppLocalizer.ProfilePageTitle}">
    <Grid Padding="16"
          RowDefinitions="Auto,*"
          RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="ProfileNameLabel"
                       Text="{Binding ProfileNameLabel}"
                       FontSize="20"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="ProfileHeadlineLabel"
                       Text="{Binding ProfileHeadlineLabel}"
                       TextColor="#666666"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button x:Name="EditSaveButton"
                    Grid.Column="1"
                    Text="{x:Static app:AppLocalizer.EditAction}"
                    Clicked="OnEditSaveClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <Border Padding="12"
                        Stroke="#D8DEE4"
                        StrokeThickness="1"
                        Background="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static app:AppLocalizer.ContactTitle}"
                               FontAttributes="Bold" />
                        <Entry x:Name="FullNameEntry"
                               Text="{Binding FullName}"
                               Placeholder="{x:Static app:AppLocalizer.FullName}" />
                        <Entry x:Name="EmailEntry"
                               Text="{Binding Email}"
                               Placeholder="{x:Static app:AppLocalizer.Email}"
                               Keyboard="Email" />
                        <Entry x:Name="PhoneEntry"
                               Text="{Binding Phone}"
                               Placeholder="{x:Static app:AppLocalizer.Phone}"
                               Keyboard="Telephone" />
                        <Entry x:Name="AddressEntry"
                               Text="{Binding AddressLine1}"
                               Placeholder="{x:Static app:AppLocalizer.Address}" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Entry x:Name="CityEntry"
                                   Text="{Binding City}"
                                   Placeholder="{x:Static app:AppLocalizer.City}" />
                            <Entry x:Name="StateEntry"
                                   Text="{Binding StateOrProvince}"
                                   Grid.Column="1"
                                   Placeholder="{x:Static app:AppLocalizer.State}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Entry x:Name="PostalCodeEntry"
                                   Text="{Binding PostalCode}"
                                   Placeholder="{x:Static app:AppLocalizer.PostalCode}" />
                            <Entry x:Name="CountryEntry"
                                   Text="{Binding Country}"
                                   Grid.Column="1"
                                   Placeholder="{x:Static app:AppLocalizer.Country}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12"
                        Stroke="#D8DEE4"
                        StrokeThickness="1"
                        Background="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static app:AppLocalizer.OnlineProfilesTitle}"
                               FontAttributes="Bold" />
                        <Entry x:Name="LinkedInEntry"
                               Text="{Binding LinkedInUrl}"
                               Placeholder="{x:Static app:AppLocalizer.LinkedInUrl}"
                               Keyboard="Url" />
                        <Entry x:Name="PortfolioEntry"
                               Text="{Binding PortfolioUrl}"
                               Placeholder="{x:Static app:AppLocalizer.PortfolioUrl}"
                               Keyboard="Url" />
                        <Entry x:Name="GitHubEntry"
                               Text="{Binding GitHubUrl}"
                               Placeholder="{x:Static app:AppLocalizer.GitHubUrl}"
                               Keyboard="Url" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12"
                        Stroke="#D8DEE4"
                        StrokeThickness="1"
                        Background="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static app:AppLocalizer.ResumeTitle}"
                               FontAttributes="Bold" />
                        <Entry x:Name="CurrentTitleEntry"
                               Text="{Binding CurrentTitle}"
                               Placeholder="{x:Static app:AppLocalizer.CurrentTitle}" />
                        <Entry x:Name="CurrentCompanyEntry"
                               Text="{Binding CurrentCompany}"
                               Placeholder="{x:Static app:AppLocalizer.CurrentCompany}" />
                        <Entry x:Name="YearsExperienceEntry"
                               Text="{Binding YearsExperience}"
                               Placeholder="{x:Static app:AppLocalizer.YearsOfExperience}"
                               Keyboard="Numeric" />
                        <Entry x:Name="HighestEducationEntry"
                               Text="{Binding HighestEducation}"
                               Placeholder="{x:Static app:AppLocalizer.HighestEducation}" />
                        <Entry x:Name="ResumeFileNameEntry"
                               Text="{Binding ResumeFileName}"
                               Placeholder="{x:Static app:AppLocalizer.ResumeFileName}" />
                        <Editor x:Name="SkillsEditor"
                                Text="{Binding Skills}"
                                Placeholder="{x:Static app:AppLocalizer.Skills}"
                                AutoSize="TextChanges"
                                HeightRequest="96" />
                        <Editor x:Name="SummaryEditor"
                                Text="{Binding ResumeSummary}"
                                Placeholder="{x:Static app:AppLocalizer.ResumeSummary}"
                                AutoSize="TextChanges"
                                HeightRequest="132" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12"
                        Stroke="#D8DEE4"
                        StrokeThickness="1"
                        Background="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static app:AppLocalizer.EligibilityTitle}"
                               FontAttributes="Bold" />
                        <Entry x:Name="WorkAuthorizationEntry"
                               Text="{Binding WorkAuthorizationStatus}"
                               Placeholder="{x:Static app:AppLocalizer.WorkAuthorization}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Text="{x:Static app:AppLocalizer.RequiresSponsorship}"
                                   VerticalTextAlignment="Center" />
                            <Picker x:Name="SponsorshipPicker"
                                    ItemsSource="{Binding YesNoOptions}"
                                    SelectedItem="{Binding SponsorshipRequirement}"
                                    Title="Not answered"
                                    Grid.Column="1" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Text="{x:Static app:AppLocalizer.WillingToRelocate}"
                                   VerticalTextAlignment="Center" />
                            <Picker x:Name="RelocatePicker"
                                    ItemsSource="{Binding YesNoOptions}"
                                    SelectedItem="{Binding RelocationPreference}"
                                    Title="Not answered"
                                    Grid.Column="1" />
                        </Grid>
                        <Entry x:Name="PreferredWorkTypeEntry"
                               Text="{Binding PreferredWorkType}"
                               Placeholder="{x:Static app:AppLocalizer.PreferredWorkType}" />
                        <Entry x:Name="SalaryExpectationEntry"
                               Text="{Binding SalaryExpectation}"
                               Placeholder="{x:Static app:AppLocalizer.SalaryExpectation}" />
                        <Entry x:Name="NoticePeriodEntry"
                               Text="{Binding NoticePeriod}"
                               Placeholder="{x:Static app:AppLocalizer.NoticePeriod}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12"
                        Stroke="#D8DEE4"
                        StrokeThickness="1"
                        Background="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static app:AppLocalizer.VoluntaryDisclosuresTitle}"
                               FontAttributes="Bold" />
                        <Entry x:Name="GenderEntry"
                               Text="{Binding Gender}"
                               Placeholder="{x:Static app:AppLocalizer.Gender}" />
                        <Entry x:Name="RaceEntry"
                               Text="{Binding RaceEthnicity}"
                               Placeholder="{x:Static app:AppLocalizer.RaceOrEthnicity}" />
                        <Entry x:Name="HispanicLatinoEntry"
                               Text="{Binding HispanicLatino}"
                               Placeholder="{x:Static app:AppLocalizer.HispanicOrLatino}" />
                        <Entry x:Name="VeteranEntry"
                               Text="{Binding VeteranStatus}"
                               Placeholder="{x:Static app:AppLocalizer.VeteranStatus}" />
                        <Entry x:Name="DisabilityEntry"
                               Text="{Binding DisabilityStatus}"
                               Placeholder="{x:Static app:AppLocalizer.DisabilityStatus}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12"
                        Stroke="#D8DEE4"
                        StrokeThickness="1"
                        Background="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static app:AppLocalizer.AtsAnswersTitle}"
                               FontAttributes="Bold" />
                        <Editor x:Name="CoverLetterEditor"
                                Text="{Binding CoverLetter}"
                                Placeholder="{x:Static app:AppLocalizer.CoverLetterAnswer}"
                                AutoSize="TextChanges"
                                HeightRequest="120" />
                        <Editor x:Name="WhyInterestedEditor"
                                Text="{Binding WhyInterested}"
                                Placeholder="{x:Static app:AppLocalizer.WhyInterested}"
                                AutoSize="TextChanges"
                                HeightRequest="110" />
                        <Editor x:Name="AdditionalInfoEditor"
                                Text="{Binding AdditionalInfo}"
                                Placeholder="{x:Static app:AppLocalizer.AdditionalInformation}"
                                AutoSize="TextChanges"
                                HeightRequest="110" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="StatusLabel"
                       Text="{Binding StatusText}"
                       TextColor="#666666"
                       FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
