<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:app="clr-namespace:JobAutofill.App"
      xmlns:pages="clr-namespace:JobAutofill.App.Pages"
      x:Class="JobAutofill.App.AppShell">

    <TabBar x:Name="MainTabBar">
        <ShellContent Title="{x:Static app:AppLocalizer.JobsTabTitle}"
                      ContentTemplate="{DataTemplate pages:JobsListPage}" />
        <ShellContent Title="{x:Static app:AppLocalizer.ProfileTabTitle}"
                      ContentTemplate="{DataTemplate pages:ProfileEditorPage}" />
    </TabBar>

</Shell>
